# pi-secretary.sudoers — lets deploy.sh restart the service without a
# password prompt, without granting broad/passwordless sudo.
#
# Why this exists: deploy.sh's last step is `sudo systemctl restart
# pi-secretary`, which is the only genuinely root-requiring thing it does
# (starting/stopping/restarting a system-level systemd unit needs root;
# reading its status does not, so deploy.sh no longer even asks for sudo
# there). Without this file, that one line stops the deploy and waits at
# an interactive password prompt every single time — annoying for a
# manual run, and a hard blocker for ever running deploy.sh unattended
# (a cron job, a webhook-triggered redeploy, etc).
#
# This grants NOPASSWD access to exactly three commands — start, stop,
# and restart of the pi-secretary unit, nothing else — not full root, not
# "any systemctl command," not other services. jonbourgy still needs a
# password for everything else sudo currently guards.
#
# One-time install on the Pi:
#
#   sudo visudo -c -f pi-secretary.sudoers   # sanity-check syntax first
#   sudo cp pi-secretary.sudoers /etc/sudoers.d/pi-secretary
#   sudo chmod 0440 /etc/sudoers.d/pi-secretary
#   sudo visudo -c                            # confirm the installed file parses clean
#
# Before installing, confirm the systemctl path below matches your Pi —
# sudoers matches the command line exactly, including this path, so a
# mismatch (e.g. /bin/systemctl instead of /usr/bin/systemctl on a non-
# usrmerge system) means the rule silently never matches and you're back
# to a password prompt. Check with:
#
#   command -v systemctl
#
# and edit the three lines below to match if it's anything other than
# /usr/bin/systemctl.

Cmnd_Alias PI_SECRETARY_CTL = /usr/bin/systemctl restart pi-secretary, \
                               /usr/bin/systemctl start pi-secretary, \
                               /usr/bin/systemctl stop pi-secretary

jonbourgy ALL=(root) NOPASSWD: PI_SECRETARY_CTL
