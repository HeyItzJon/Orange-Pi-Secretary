# pi-secretary.service — the always-on backend + dashboard, run by systemd
# instead of a manual `nohup npm start > backend.log 2>&1 & disown`.
#
# One-time install (see the winterizing setup doc for the full walkthrough):
#
#   pkill -f "node server.js"        # stop the manually-started copy first
#   sudo cp pi-secretary.service /etc/systemd/system/pi-secretary.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now pi-secretary
#
# After that, it starts on every boot on its own — including after an
# unplug/power-loss reboot — and restarts itself automatically if it ever
# crashes. Day-to-day you never touch this file again; deploy.sh's own
# restart step is the only thing that talks to it from here on.

[Unit]
Description=Pi Secretary — backend API + dashboard
# Gmail/Calendar/market-data calls all need the network; without this,
# systemd can start the service before Wi-Fi/Ethernet actually comes up,
# and the first boot-time compose silently comes back empty.
After=network-online.target
Wants=network-online.target
# If it crashes 5 times inside 60 seconds, that's broken code, not a fluke
# — stop retrying instead of hammering the Pi in a tight restart loop
# forever.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=jonbourgy
WorkingDirectory=%h/Orange-Pi-Secretary/backend
# Finds node wherever it actually lives on this machine — an apt/NodeSource
# install, or nvm — without relying on a login shell to source .bashrc the
# way an interactive SSH session does (systemd services don't get one, so
# a plain `ExecStart=node server.js` can fail with "command not found" even
# though `npm start` works fine by hand). If this still can't find node on
# your setup, run `which node` and hardcode that exact path here instead.
ExecStart=/bin/bash -c 'for n in "$HOME"/.nvm/versions/node/*/bin/node /usr/local/bin/node /usr/bin/node; do [ -x "$n" ] && exec "$n" server.js; done; echo "pi-secretary.service: no node binary found — see the comment above ExecStart" >&2; exit 1'
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
