# --- secrets: never commit these ------------------------------------------
.env
*.env
!.env.example
*.env.bak
client_secret.json
*credentials*.json
*token*.json

# --- personal data, tracked on purpose (see commit 8bf3e1b) ----------------
# config.json and config/portfolio.json used to be gitignored, but that made
# every new machine (the Pi transfer, most recently) a hand-copy job that was
# easy to get wrong. It's a private repo Jon controls end to end, so both are
# tracked like any other file now.

# --- your data -------------------------------------------------------------
# the item store: emails, events, prices — regenerates from the sources
# above, doesn't need to travel between machines, never committed.
backend/data/

# --- build output and dependencies ----------------------------------------
node_modules/
frontend/dist/
dist/
build/

# --- noise -----------------------------------------------------------------
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/
*.tmp
