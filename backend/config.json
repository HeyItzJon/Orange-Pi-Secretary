{
  "_comment": "Secretary config. Everything you'd want to tune lives here — no code changes needed. Restart the server, or POST /api/config/reload, after editing.",

  "timezone": "America/Toronto",

  "ai": {
    "_comment": "The model is used for exactly two things: classifying emails that already passed your rules, and writing one summary line. Set provider to 'off' to run the whole system with zero AI calls — the brief still works.",
    "provider": "deepseek",
    "_provider_options": ["deepseek", "claude", "off"],
    "model": {
      "deepseek": "deepseek-chat",
      "claude": "claude-sonnet-5"
    }
  },

  "schedule": {
    "_comment": "Local times. Pulls are cheap (usually zero tokens). The brief is composed once each morning.",
    "pullTimes": ["06:30", "12:30", "18:30"],
    "briefTime": "06:40",
    "moneyTime": "17:15",
    "notesTime": "06:20"
  },

  "brief": {
    "comingUpDays": 14,
    "maxPerSection": 6,
    "maxRepeats": 6,
    "_maxRepeats_note": "After this many briefs, an unchanged item with no deadline goes quiet. Anything with a clock running is never suppressed.",
    "retainDays": 90
  },

  "email": {
    "query": "in:inbox -in:trash -in:spam -category:promotions -category:social newer_than:14d",
    "maxResults": 40,
    "minScore": 60,
    "_minScore_note": "Emails scoring below this never reach the model. Lower it to widen the net, raise it to spend less."
  },

  "rules": {
    "_comment": "Priority order you set: opportunities first, then work and family, then school.",

    "tierScores": {
      "opportunity": 100,
      "work": 92,
      "family": 90,
      "school": 78,
      "personal": 60
    },

    "people": [
      { "match": ["mom", "mum", "mother"], "label": "Mom", "tier": "family" },
      { "match": ["dad", "father"], "label": "Dad", "tier": "family" },
      { "match": ["dave leal", "leal"], "label": "Dave Leal", "tier": "work" },
      { "match": ["samantha cowley", "cowley"], "label": "Samantha Cowley", "tier": "work" },
      { "match": ["jill desjardins", "desjardins"], "label": "Jill Desjardins", "tier": "work" }
    ],

    "domains": [
      { "match": "ottawa.ca", "label": "City of Ottawa", "tier": "work" }
    ],

    "topics": {
      "opportunity": {
        "score": 100,
        "keywords": [
          "interview", "interviews", "position", "job", "hiring", "hire",
          "application", "applied", "co-op", "coop", "internship", "intern",
          "offer", "recruiter", "recruitment", "posting", "candidate",
          "resume", "cv", "cover letter", "prospectus", "opportunity",
          "shortlisted", "onboarding", "reference check"
        ]
      },
      "work": {
        "score": 92,
        "keywords": [
          "richcraft", "recreation complex", "rec complex", "shift", "shifts",
          "schedule change", "timesheet", "payroll", "availability",
          "lifeguard", "aquatics", "facility", "supervisor"
        ]
      },
      "school": {
        "score": 78,
        "keywords": [
          "assignment", "midterm", "final exam", "quiz", "deadline", "due date",
          "lab report", "tutorial", "syllabus", "grade", "professor",
          "registration", "enrolment", "enrollment", "tuition", "transcript"
        ]
      }
    },

    "mute": ["noreply@", "no-reply@", "donotreply@", "notifications@", "mailer-daemon"]
  },

  "calendar": {
    "targets": [
      "jon.m.bourget@gmail.com",
      "IMPORTANT EVENTS",
      "Tests & Quizzes",
      "School & Classes",
      "WORK",
      "Sydney's Demands",
      "CANNOT MISS"
    ],
    "alwaysImportant": ["CANNOT MISS", "IMPORTANT EVENTS", "Tests & Quizzes"],
    "horizonDays": 14
  },

  "money": {
    "_comment": "Money speaks only when one of these fires. Most days it says nothing.",
    "dayMovePct": 5,
    "driftBandPct": 5,
    "contributionDayOfMonth": null,
    "_contributionDayOfMonth_note": "Set to a day (e.g. 1) to get a reminder. Leave null to disable.",
    "contributionLabel": "Contribution day",
    "contributionLeadDays": 1
  },

  "notes": {
    "vaultPath": "C:\\Users\\jonmb\\Documents\\Obsidian\\Jon's Synced Vault",
    "watchFolders": ["Areas/Projects", "Projects", "Areas/Finances"],
    "_watchFolders_note": "Case-insensitive path fragments. Empty array = whole vault.",
    "staleDays": 10,
    "maxItems": 4
  }
}
