# Copy this file to ".env" (same folder) and fill in whichever key you need.
# You only need the key for the provider you set in config.json ("aiProvider").

DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

PORT=3001

# Gmail OAuth — needed for the email source and doctor.js's Google checks.
# See INTEGRATIONS.md / VAULT-PLAN.md for how to obtain these, or run
# `npm run get-refresh-token` to mint a fresh GMAIL_REFRESH_TOKEN any time
# the old one dies (expired, revoked, or a rotated client secret — Gmail
# and Calendar always fail together with the same error when this happens).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Optional. Overrides config.json's vault.path on THIS machine only — set
# this when the same repo (and its tracked config.json) runs on more than
# one machine, since a Windows path and a Linux path can never both be
# right in one shared, git-tracked file. Leave unset if this is the only
# machine running this app; config.json's own vault.path is enough.
# See lib/paths.js's resolveVaultPath for the exact precedence.
VAULT_PATH=
