# Copy this file to ".env" (same folder) and fill in whichever key you need.
# You only need the key for the provider you set in config.json ("aiProvider").

DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

PORT=3001

# Gmail OAuth — needed for the email source and doctor.js's Google checks.
# See INTEGRATIONS.md / VAULT-PLAN.md for how to obtain these.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
